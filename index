<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Jeju Road Trip for Anup</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,750&family=Source+Sans+3:wght@400;600&family=Noto+Sans+KR:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{
  /* Layout: sticky island map on the left, day-by-day stops on the right; stacks on phones */
  --bg:#f4f6f3; --surface:#ffffff; --ink:#1d2523; --muted:#5d6b67; --line:#d9e0dc;
  --sea:#d7e9ea; --land:#e9efe2; --landline:#9fb3a6; --accent:#e0a800;
  --d1:#1f7a8a; --d2:#d97b2f; --d3:#7a45a0; --d4:#c43f5a;
  --display:"Bricolage Grotesque", "Segoe UI", system-ui, sans-serif;
  --body:"Source Sans 3", "Noto Sans KR", system-ui, -apple-system, sans-serif;
  color-scheme: light;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#121716; --surface:#1a2120; --ink:#e7ecea; --muted:#9aa8a3; --line:#2c3633;
    --sea:#14282b; --land:#26302b; --landline:#4b5e55; --accent:#f2c230;
    --d1:#3fb0c2; --d2:#f0954a; --d3:#b07ad6; --d4:#ec6b86; color-scheme: dark;
  }
}
:root[data-theme="dark"]{
  --bg:#121716; --surface:#1a2120; --ink:#e7ecea; --muted:#9aa8a3; --line:#2c3633;
  --sea:#14282b; --land:#26302b; --landline:#4b5e55; --accent:#f2c230;
  --d1:#3fb0c2; --d2:#f0954a; --d3:#b07ad6; --d4:#ec6b86; color-scheme: dark;
}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--bg);color:var(--ink);font:16px/1.5 var(--body)}
a{color:inherit}
a:focus-visible,.pin:focus-visible,button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.wrap{max-width:1280px;margin:0 auto;padding:28px 20px 48px}
.top h1{font:750 clamp(28px,4vw,44px)/1.05 var(--display);margin:0 0 8px;text-wrap:balance;letter-spacing:-.01em}
.top p{margin:0;color:var(--muted);max-width:70ch}
.facts{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0 0;padding:0;list-style:none}
.facts li{background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:4px 12px;font-size:14px}
.grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:28px;margin-top:24px;align-items:start}
.mapcard{position:sticky;top:12px;background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:12px}
#map{width:100%;height:auto;display:block;border-radius:10px}
.mapscroll{overflow-x:auto;border-radius:10px}
@media (max-width:600px){#map{min-width:640px}}
.sea{fill:var(--sea)} .land{fill:var(--land);stroke:var(--landline);stroke-width:1.2;stroke-linejoin:round}
.peak{fill:var(--landline);opacity:.7}
.lm{font:600 17px var(--body);fill:var(--muted);letter-spacing:.02em}
.route{fill:none;stroke-width:3.5;stroke-dasharray:2 6;stroke-linecap:round;opacity:.85}
.route.d1{stroke:var(--d1)} .route.d2{stroke:var(--d2)} .route.d3{stroke:var(--d3)} .route.d4{stroke:var(--d4)}
.pin{cursor:pointer}
.pin circle,.pin rect{stroke:var(--surface);stroke-width:2}
.pin text{font:700 15px var(--body);fill:#fff;pointer-events:none}
.pin.d1 circle,.pin.hotel.d1 rect{fill:var(--d1)} .pin.d2 circle,.pin.hotel.d2 rect{fill:var(--d2)}
.pin.d3 circle,.pin.hotel.d3 rect{fill:var(--d3)} .pin.d4 circle{fill:var(--d4)}
.pin.opt circle{fill:var(--accent)} .pin.opt text{fill:#1d2523;font-size:13px}
.pin.dim,.route.dim{opacity:.12}
.pin.hl circle,.pin.hl rect{stroke:var(--accent);stroke-width:3.5}
.filters{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 10px}
.filters button{font:600 14px var(--body);border:1px solid var(--line);background:var(--bg);color:var(--ink);border-radius:999px;padding:5px 12px;cursor:pointer}
.filters button[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
.filters .sw{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:6px;vertical-align:0}
.legend{display:flex;flex-wrap:wrap;gap:14px;font-size:13px;color:var(--muted);margin-top:8px}
.day{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px 18px 8px;margin-bottom:18px}
.day-h{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;margin-bottom:6px}
.day-h h2{font:650 21px/1.2 var(--display);margin:0;text-wrap:balance}
.dlabel{font:700 12px var(--body);text-transform:uppercase;letter-spacing:.08em;color:#fff;border-radius:6px;padding:3px 8px}
.dlabel.d1,.num.d1,.hbadge.d1,.sw.d1{background:var(--d1)} .dlabel.d2,.num.d2,.hbadge.d2,.sw.d2{background:var(--d2)}
.dlabel.d3,.num.d3,.hbadge.d3,.sw.d3{background:var(--d3)} .dlabel.d4,.num.d4,.hbadge.d4,.sw.d4{background:var(--d4)}
.stops{list-style:none;margin:0;padding:0}
.stop{display:grid;grid-template-columns:30px 1fr;gap:12px;padding:12px 0;border-top:1px solid var(--line);scroll-margin-top:16px}
.stop:first-child{border-top:0}
.stop.hl{background:linear-gradient(90deg,color-mix(in srgb,var(--accent) 16%,transparent),transparent);border-radius:8px}
.num{width:28px;height:28px;border-radius:50%;color:#fff;font:700 13px/28px var(--body);text-align:center}
.row1{display:flex;flex-wrap:wrap;gap:6px;align-items:center;font-size:13px}
.time{font-variant-numeric:tabular-nums;font-weight:600;color:var(--muted)}
.kind{border:1px solid var(--line);border-radius:999px;padding:0 8px;color:var(--muted)}
.kind.k-food{border-color:var(--d1);color:var(--d1)} .kind.k-sweet{border-color:var(--accent);color:var(--ink)}
.veg{background:color-mix(in srgb,#3c9a5f 16%,transparent);color:#2f7d4c;border-radius:999px;padding:0 8px;font-weight:600}
:root[data-theme="dark"] .veg{color:#7fd39d}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]) .veg{color:#7fd39d}}
.stop h3{font:650 17px/1.3 var(--body);margin:4px 0 2px}
.ko{font-family:"Noto Sans KR",var(--body);font-weight:400;color:var(--muted);font-size:.9em}
.stop p{margin:0;max-width:65ch}
.addr{font-size:13px;color:var(--muted);margin-top:2px}
.links{display:flex;gap:12px;margin-top:6px;font-size:14px;font-weight:600}
.links a{text-decoration:underline;text-underline-offset:3px;text-decoration-color:var(--line)}
.stay{border-top:2px dashed var(--line);margin-top:4px;padding:12px 0 10px;scroll-margin-top:16px}
.stay-h{font-weight:700;display:flex;align-items:center;gap:8px}
.hbadge{display:inline-block;width:22px;height:22px;border-radius:5px;color:#fff;font:700 12px/22px var(--body);text-align:center}
.stay ul{margin:6px 0 0;padding-left:20px} .stay li{margin:6px 0} .stay a{font-size:14px;font-weight:600}
.notes{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:16px;margin-top:8px}
.note{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:16px 18px}
.note h2{font:650 18px/1.25 var(--display);margin:0 0 8px}
.note ul{margin:0;padding-left:18px} .note li{margin:4px 0}
.phrase{font-family:"Noto Sans KR",var(--body);font-size:18px;line-height:1.5;background:var(--bg);border:1px solid var(--line);border-radius:10px;padding:10px 12px;margin:8px 0}
.copy{font:600 14px var(--body);border:1px solid var(--ink);background:var(--ink);color:var(--bg);border-radius:8px;padding:6px 12px;cursor:pointer}
.startday{margin-top:8px;margin-bottom:16px}
.tbl{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:15px}
th,td{text-align:left;padding:8px 10px;border-top:1px solid var(--line);vertical-align:top}
th{font-weight:600;color:var(--muted);border-top:0}
.ok,.mid,.bad{display:inline-block;font-weight:700;font-size:12px;border-radius:999px;padding:1px 8px;margin-right:6px;color:#fff}
.ok{background:#2f8a55}.mid{background:#b07a00}.bad{background:#b8443c}
@media print{
  body{background:#fff}
  .wrap{padding:0 6mm}
  .grid{grid-template-columns:1fr}
  .mapcard{position:static;break-inside:avoid}
  .filters{display:none}
  .mapscroll{overflow:visible} #map{min-width:0}
  .stop,.stay,.note,.startday tr{break-inside:avoid}
  .day{break-inside:auto}
  .copy{display:none}
  a{color:inherit}
}
.foot{color:var(--muted);font-size:13px;margin-top:24px;max-width:80ch}
@media (max-width:900px){.grid{grid-template-columns:minmax(0,1fr)}.mapcard{position:static}}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
html{scroll-behavior:smooth}
</style>
</head>
